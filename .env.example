# Copy to apps/api/.env:  cp .env.example apps/api/.env
# These are development placeholders, never real secrets.
DATABASE_URL="postgresql://devflow:devflow_local@localhost:5432/devflow"
JWT_ACCESS_SECRET="change-me-access-secret"
PORT=4000

# apps/web needs only this (it defaults to http://localhost:4000 when unset),
# as an environment variable or apps/web/.env.local.
# API_URL="http://localhost:4000"

# Optional: only when a browser calls the API cross-origin directly, which the
# bundled web app never does — it proxies /api/v1/* same-origin.
# CORS_ORIGIN="http://localhost:3000"
